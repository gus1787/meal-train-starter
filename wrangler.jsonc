{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meal-train-starter",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-train-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "START_DATE": "",
    "TRAIN_DAYS": "21",
    "TRAIN_TIME_ZONE": "UTC"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "419467",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
